{
  "name": "piped-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "build": "vite build",
    "build:development": "vite build --mode development",
    "preview": "vite preview",
    "check:tooling": "node scripts/check-tooling.mjs",
    "check:production": "node scripts/check-build.mjs",
    "check:development": "node scripts/check-build.mjs --development"
  },
  "dependencies": {
    "@lucide/vue": "1.77.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
