# Reference defaults. Create a usable .env with ./bin/piped keygen.

# Required: base64-encoded 32-byte random key; no default.
PIPED_ENCRYPTION_KEY=

# sqlite (default), postgres, mariadb, or mysql.
PIPED_DATABASE_DRIVER=sqlite

# Required for server databases; empty for SQLite. Contains credentials: keep private.
PIPED_DATABASE_DSN=

# SQLite only. Relative to the working directory unless absolute.
PIPED_DATABASE_PATH=data/piped.db

# Server listen address.
PIPED_LISTEN=127.0.0.1:8080

# Exact browser-facing origin, without a trailing slash.
PIPED_PUBLIC_URL=http://127.0.0.1:8080

# Comma-separated proxy IP addresses or CIDRs. Empty disables forwarded client IPs.
PIPED_TRUSTED_PROXIES=127.0.0.0/8

# Job output retention in days (1 to 36500).
PIPED_LOG_RETENTION_DAYS=7
